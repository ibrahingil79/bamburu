# Dependencias
node_modules/

# Datos (BD de tenants y control)
data/
*.db
*.db-shm
*.db-wal

# Secretos / variables de entorno
.env
.env.*

# Backups y copias antiguas
*.bak
*.bak2
modules/*.backup.*/

# Estado local de Claude Code (no compartir)
.claude/settings.local.json
.claude/session.json

# Temporales / sistema
/tmp
.DS_Store
*.swp
Thumbs.db

# Certificados y claves privadas — NUNCA al repositorio.
# El .p12/.pfx del FNMT (Verifactu, mTLS contra la AEAT) vive fuera del árbol de trabajo y se
# referencia por VERIFACTU_CERT_PATH. Esta red de seguridad evita subirlo por un `git add -A`.
*.p12
*.pfx
*.pem
*.key
*.jks
*.crt

# Registros y prompts del orquestador (ruido local, no van al repo)
logs/

# Estado en vivo del orquestador (no se versiona)
.orquestador/
