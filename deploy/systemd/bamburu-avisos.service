[Unit]
Description=Bamburu — resumen diario de avisos por email (cobros vencidos, pagos, stock, recurrentes)
Documentation=file:///home/ubuntu/bamburu/deploy/systemd/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/bamburu
# Secretos (RESEND_API_KEY) — el mismo EnvironmentFile que la app.
EnvironmentFile=/etc/bamburu.env
# El .mjs itera TODOS los tenants (data/tenants/*.db) por sí mismo (no hace falta bash).
ExecStart=/usr/bin/node /home/ubuntu/bamburu/scripts/bamburu-avisos.mjs
SyslogIdentifier=bamburu-avisos
