[Unit]
Description=Bamburu — heartbeat: avisa (Telegram + email) si una copia lleva +26h sin éxito
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/bamburu
EnvironmentFile=/etc/bamburu.env
ExecStart=/home/ubuntu/bamburu/scripts/bamburu-backup-heartbeat.sh
SyslogIdentifier=bamburu-backup-heartbeat
