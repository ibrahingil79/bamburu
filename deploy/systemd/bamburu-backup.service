[Unit]
Description=Bamburu — copia diaria de BD + uploads a Google Drive (rclone), verificada
Documentation=file:///home/ubuntu/bamburu/deploy/systemd/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/bamburu
EnvironmentFile=/etc/bamburu.env
ExecStart=/home/ubuntu/bamburu/scripts/bamburu-backup.sh
SyslogIdentifier=bamburu-backup
