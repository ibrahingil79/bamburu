[Unit]
Description=Bamburu — disparador diario de la copia a Google Drive (03:30)

[Timer]
# Diario a las 03:30 hora local. Los datos son pequeños: diario no cuesta nada.
OnCalendar=*-*-* 03:30:00
# Si el servidor estaba apagado a esa hora, ejecuta en el siguiente arranque.
Persistent=true
# Pequeño desfase aleatorio para no clavar siempre el mismo segundo.
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
