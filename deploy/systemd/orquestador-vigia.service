# Vigía del orquestador — atiende las órdenes que Ibrahin manda por Telegram.
#
# Va en su PROPIO servicio, aparte de orquestador.service, a propósito:
# la pregunta que más falta hace es «¿qué está pasando?», y hay que poder hacerla justo
# cuando el orquestador lleva media hora metido en una llamada, o cuando se ha caído.
# Dentro del ciclo solo contestaría cuando el ciclo tuviera un rato libre.
#
# INSTALAR:
#   sudo cp deploy/systemd/orquestador-vigia.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now orquestador-vigia
#
# VER:   systemctl status orquestador-vigia --no-pager
#        tail -f logs/vigia.log

[Unit]
Description=Vigia del orquestador de Bamburu (ordenes por Telegram)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/bamburu
ExecStart=/usr/bin/node /home/ubuntu/bamburu/orchestrator/orq.js escuchar

Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin

# Las dos claves de Telegram. Las mismas que usa el orquestador.
EnvironmentFile=-/etc/orquestador.env

# El vigía no tiene nada que terminar: se para en cuanto se le dice.
KillSignal=SIGTERM
TimeoutStopSec=30

Restart=always
RestartSec=10

# Superficie mínima. El vigía NO ejecuta órdenes libres: solo escribe en la bandeja del
# orquestador y manda señales a su pid. No necesita nada más.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/bamburu
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=orquestador-vigia

[Install]
WantedBy=multi-user.target
