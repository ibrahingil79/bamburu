# Orquestador de Bamburu — Architect → Programmer → Review, desatendido.
#
# INSTALAR:
#   sudo cp deploy/systemd/orquestador.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now orquestador
#
# VER:   systemctl status orquestador --no-pager
#        sudo journalctl -u orquestador -f
#        node orchestrator/orq.js estado
#
# PARAR BIEN (termina el paso en curso si le da tiempo, y no empieza otro):
#        sudo systemctl stop orquestador        ← manda SIGTERM
#        Devuelve el control en menos de medio minuto. Un SEGUNDO SIGTERM corta ya, sin plazo.
# PARAR DE GOLPE (puede dejar algo a medias):
#        node orchestrator/orq.js parar-ya      ← manda SIGINT

[Unit]
Description=Orquestador de Bamburu (Architect - Programmer - Review)
Documentation=file:///home/ubuntu/bamburu/docs/orquestador/paso-0-diagnostico.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/bamburu
ExecStart=/usr/bin/node /home/ubuntu/bamburu/orchestrator/orq.js arrancar

# HOME es lo ÚNICO imprescindible para que el CLI encuentre ~/.claude/.credentials.json.
# Está medido: con `env -i HOME=... PATH=...` la invocación funciona.
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin

# ── LA CLAVE DE TELEGRAM LA PONE IBRAHIN, NO EL ORQUESTADOR ──────────────────
# Crea /etc/orquestador.env con permisos 600 y estas dos líneas:
#     ORQUESTADOR_TELEGRAM_TOKEN=123456:AA...
#     ORQUESTADOR_TELEGRAM_CHAT_ID=987654321
# Sin ese fichero el ciclo funciona igual: los partes se guardan y se mandan al configurarlo.
EnvironmentFile=-/etc/orquestador.env

# ── LA PARADA, Y POR QUÉ ESTE NÚMERO Y NO 2100 (1 sep 2026, avería 3) ────────
# Aquí ponía 2100 (35 min), elegido para superar los 30 del timeout por llamada «para que nunca
# lo corte a mitad». La consecuencia real: un `systemctl restart` con el arquitecto trabajando se
# quedó COLGADO y hubo que matarlo con SIGKILL — que es exactamente lo que estos 35 minutos
# pretendían evitar, y encima sin plazo ni aviso.
#
# Ahora el que corta es el daemon, no systemd: `ciclo.plazoParadaMs` (20 s) le da al paso en
# curso una cortesía corta y luego lo corta él mismo, dejando la tarea en su paso, en el journal,
# para retomarla. Este tope queda MUY por encima de esos 20 s a propósito: no es el mecanismo de
# parada, es la red por si el daemon se queda tonto. Que sean 2 min y no 35 significa que un
# daemon colgado se ve en dos minutos.
KillSignal=SIGTERM
TimeoutStopSec=120
KillMode=mixed

# Que no se muera: si se cae, vuelve.
Restart=always
RestartSec=30

# Superficie mínima. El orquestador solo necesita escribir en su repo.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/bamburu /home/ubuntu/.claude
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=orquestador

[Install]
WantedBy=multi-user.target
