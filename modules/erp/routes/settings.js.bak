import { Hono } from 'hono';
import { adminLayout } from '../layout.js';
import { requirePerm } from '../../../core/auth.js';
import { validate } from '../../../core/validate.js';
import { companySchema, storeSettingsSchema } from '../schemas.js';
import { getCountryConfig } from '../../../core/control-db.js';

export function createSettingsRoutes(db, cfg = {}) {
  const sym = cfg.sym || '€';
  const api = new Hono();
  const views = new Hono();
  const storeViews = new Hono();

  // ── API: COMPANY ───────────────────────────────────────────────
  api.get('/company', requirePerm('company.read'), c => {
    try { return c.json(db.prepare('SELECT * FROM company_config WHERE id=1').get()); }
    catch(e) { return c.json({error:e.message},500); }
  });

  api.put('/company', requirePerm('company.update'), validate(companySchema), async c => {
    try {
      const d = c.get('validated');
      db.prepare('UPDATE company_config SET company_name=?,fiscal_id=?,tax_rate=?,logo_url=?,address=?,phone=?,email=?,website=?,country=?,currency=?,currency_symbol=?,tax_name=?,fiscal_id_label=?,document_name=? WHERE id=1').run(d.company_name||'', d.fiscal_id||'', parseFloat(d.tax_rate)||0, d.logo_url||'', d.address||'', d.phone||'', d.email||'', d.website||'', d.country||'ES', d.currency||'EUR', d.currency_symbol||sym, d.tax_name||'IVA', d.fiscal_id_label||'NIF/CIF', d.document_name||'Factura');
      return c.json({message:'Guardado'});
    } catch(e) { return c.json({error:e.message},500); }
  });

  // ── API: STORE ─────────────────────────────────────────────────
  api.get('/store', requirePerm('store_settings.read'), c => {
    try { return c.json(db.prepare('SELECT * FROM store_settings WHERE id=1').get()); }
    catch(e) { return c.json({error:e.message},500); }
  });

  api.put('/store', requirePerm('store_settings.update'), validate(storeSettingsSchema), async c => {
    try {
      const d = c.get('validated');
      db.prepare('UPDATE store_settings SET store_name=?,tagline=?,logo_url=?,banner_url=?,primary_color=?,announcement=?,facebook_url=?,instagram_url=?,twitter_url=?,terms_html=?,privacy_html=?,returns_html=?,seo_title=?,seo_description=?,theme=? WHERE id=1').run(d.store_name||'', d.tagline||'', d.logo_url||'', d.banner_url||'', d.primary_color||'#10b981', d.announcement||'', d.facebook_url||'', d.instagram_url||'', d.twitter_url||'', d.terms_html||'', d.privacy_html||'', d.returns_html||'', d.seo_title||'', d.seo_description||'', d.theme||'minimal_light');
      return c.json({message:'Guardado'});
    } catch(e) { return c.json({error:e.message},500); }
  });

  // ── VIEW: COMPANY SETTINGS ─────────────────────────────────────
  views.get('/', c => {
    const config = db.prepare('SELECT * FROM company_config WHERE id=1').get() || {};
    const sym = config.currency_symbol || '€';
    const countryInfo = getCountryConfig(config.country || 'ES');
    const countryName = countryInfo ? countryInfo.name : (config.country || 'España');
    const content = `
      <div class="ph"><h2>Configuración Empresa</h2></div>
      <div class="card" style="max-width:700px">
        <div class="card-body">
          <div class="form-row">
            <div class="form-group"><label class="form-label">Nombre de la empresa</label><input class="form-control" id="cName"></div>
            <div class="form-group"><label class="form-label">NIF / ID Fiscal</label><input class="form-control" id="cFiscal"></div>
          </div>
          <div class="form-group">
            <label class="form-label">País</label>
            <input type="text" class="form-control" value="${countryName}" disabled style="background:#f8fafc;color:#64748b;cursor:not-allowed">
            <input type="hidden" id="countryCode" value="${config.country || 'ES'}">
            <small style="color:#94a3b8;font-size:12px;margin-top:4px;display:block">El país se configura al crear el negocio y no puede cambiarse.</small>
          </div>
          <div class="form-row">
            <div class="form-group"><label class="form-label">Moneda (código)</label><input class="form-control" id="currencyCode"></div>
            <div class="form-group"><label class="form-label">Símbolo de moneda</label><input class="form-control" id="currencySymbol" style="max-width:120px"></div>
          </div>
          <div class="form-row">
            <div class="form-group"><label class="form-label">Nombre del impuesto</label><input class="form-control" id="taxName"></div>
            <div class="form-group"><label class="form-label">Etiqueta ID fiscal</label><input class="form-control" id="fiscalIdLabel"></div>
          </div>
          <div class="form-row">
            <div class="form-group"><label class="form-label">Nombre documento fiscal</label><input class="form-control" id="documentName"></div>
            <div class="form-group"><label class="form-label">Impuesto por defecto (%)</label><input class="form-control" type="number" id="cTax" min="0" max="100" step="0.1"></div>
          </div>
          <div class="form-row">
            <div class="form-group"><label class="form-label">Email</label><input class="form-control" type="email" id="cEmail"></div>
            <div class="form-group"><label class="form-label">Teléfono</label><input class="form-control" id="cPhone"></div>
          </div>
          <div class="form-row">
            <div class="form-group"><label class="form-label">Web</label><input class="form-control" id="cWeb"></div>
          </div>
          <div class="form-group"><label class="form-label">Dirección fiscal</label><input class="form-control" id="cAddr"></div>
          <div class="form-group"><label class="form-label">URL Logo empresa</label><input class="form-control" id="cLogo"></div>
          <button class="btn btn-primary" onclick="saveCompany()">Guardar cambios</button>
        </div>
      </div>

      <div class="card" style="margin-top:24px;padding:1.5rem 2rem">
        <h3 style="font-size:16px;font-weight:600;color:#1e293b;margin-bottom:4px">Seguridad de tu cuenta</h3>
        <p style="font-size:13px;color:#64748b;margin-bottom:16px">Configura la autenticación de dos factores (2FA) para proteger tu cuenta.</p>
        <a href="/admin/setup-2fa" class="btn btn-primary">Configurar autenticación 2FA</a>
      </div>

      <script>
      api('GET','/api/erp/settings/company').then(d=>{
        document.getElementById('cName').value=d.company_name||'';
        document.getElementById('cFiscal').value=d.fiscal_id||'';
        document.getElementById('currencyCode').value=d.currency||'EUR';
        document.getElementById('currencySymbol').value=d.currency_symbol||'${sym}';
        document.getElementById('taxName').value=d.tax_name||'IVA';
        document.getElementById('fiscalIdLabel').value=d.fiscal_id_label||'NIF/CIF';
        document.getElementById('documentName').value=d.document_name||'Factura';
        document.getElementById('cTax').value=d.tax_rate||21;
        document.getElementById('cEmail').value=d.email||'';
        document.getElementById('cPhone').value=d.phone||'';
        document.getElementById('cWeb').value=d.website||'';
        document.getElementById('cAddr').value=d.address||'';
        document.getElementById('cLogo').value=d.logo_url||'';
      });
      async function saveCompany(){
        try{await api('PUT','/api/erp/settings/company',{company_name:document.getElementById('cName').value,fiscal_id:document.getElementById('cFiscal').value,country:document.getElementById('countryCode').value,currency:document.getElementById('currencyCode').value,currency_symbol:document.getElementById('currencySymbol').value,tax_name:document.getElementById('taxName').value,fiscal_id_label:document.getElementById('fiscalIdLabel').value,document_name:document.getElementById('documentName').value,tax_rate:document.getElementById('cTax').value,email:document.getElementById('cEmail').value,phone:document.getElementById('cPhone').value,website:document.getElementById('cWeb').value,address:document.getElementById('cAddr').value,logo_url:document.getElementById('cLogo').value});toast('Guardado ✓');}catch(e){toast(e.message,'err')}
      }
      </script>`;
    return c.html(adminLayout('Configuración Empresa', content, 'settings', c.get('session')?.csrfToken || '', c.get('session')?.role || ''));
  });

  storeViews.get('/', c => {
    const sym = db.prepare('SELECT currency_symbol FROM company_config WHERE id=1').get()?.currency_symbol || '€';
    const content = `
      <style>
        .constructor-wrapper {
          display: flex;
          gap: 1.5rem;
          height: calc(100vh - 120px);
          margin-top: -0.5rem;
        }
        .constructor-sidebar {
          width: 450px;
          min-width: 450px;
          background: var(--bg2);
          border: 1px solid var(--border);
          border-radius: var(--radius-lg);
          display: flex;
          flex-direction: column;
          overflow: hidden;
          box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        }
        .sidebar-scrollable-content {
          flex: 1;
          overflow-y: auto;
          padding: 1.25rem;
        }
        .sidebar-footer {
          padding: 1rem 1.25rem;
          border-top: 1px solid var(--border);
          background: var(--bg3);
        }
        .constructor-preview-container {
          flex: 1;
          display: flex;
          flex-direction: column;
          background: #090d16;
          border: 1px solid var(--border);
          border-radius: var(--radius-lg);
          overflow: hidden;
          box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        }
        .preview-header {
          background: var(--bg3);
          border-bottom: 1px solid var(--border);
          padding: 0.75rem 1.25rem;
          display: flex;
          justify-content: space-between;
          align-items: center;
        }
        .preview-status {
          display: flex;
          align-items: center;
          gap: 0.5rem;
          font-size: 0.75rem;
          color: var(--text2);
        }
        .status-dot {
          width: 8px;
          height: 8px;
          border-radius: 50%;
          background: var(--teal);
          box-shadow: 0 0 8px var(--teal);
          animation: previewPulse 2s infinite;
        }
        @keyframes previewPulse {
          0% { opacity: 0.4; }
          50% { opacity: 1; }
          100% { opacity: 0.4; }
        }
        .preview-device-selector {
          display: flex;
          gap: 0.25rem;
          background: rgba(255,255,255,0.05);
          padding: 0.2rem;
          border-radius: 6px;
        }
        .device-btn {
          border: none;
          background: none;
          color: var(--text3);
          padding: 0.35rem 0.6rem;
          border-radius: 4px;
          cursor: pointer;
          font-size: 0.75rem;
          font-weight: 600;
          transition: all 0.15s;
          display: flex;
          align-items: center;
          gap: 0.3rem;
        }
        .device-btn.active {
          background: var(--teal-soft);
          color: var(--teal);
        }
        .preview-iframe-wrapper {
          flex: 1;
          display: flex;
          align-items: center;
          justify-content: center;
          padding: 1.5rem;
          overflow: auto;
          position: relative;
        }
        #previewIframe {
          border: none;
          background: #fff;
          box-shadow: 0 15px 45px rgba(0,0,0,0.4);
          transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        #previewIframe.desktop-size {
          width: 100%;
          height: 100%;
          border-radius: 4px;
        }
        #previewIframe.mobile-size {
          width: 375px;
          height: 667px;
          border: 10px solid #1e293b;
          border-radius: 36px;
        }
        .theme-selector-grid {
          display: flex;
          flex-direction: column;
          gap: 0.75rem;
          margin-bottom: 1.25rem;
        }
        .theme-card {
          display: flex;
          align-items: center;
          gap: 1rem;
          padding: 0.75rem;
          background: rgba(255,255,255,0.02);
          border: 1px solid var(--border);
          border-radius: 8px;
          cursor: pointer;
          transition: all 0.15s ease;
        }
        .theme-card:hover {
          background: rgba(255,255,255,0.05);
          border-color: var(--border2);
        }
        .theme-card.active {
          background: var(--teal-soft);
          border-color: var(--teal);
          box-shadow: 0 0 10px rgba(20,184,166,0.1);
        }
        .theme-card-preview {
          width: 48px;
          height: 48px;
          border-radius: 6px;
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          position: relative;
          overflow: hidden;
          flex-shrink: 0;
        }
        .theme-colors {
          display: flex;
          gap: 2px;
          position: absolute;
          bottom: 4px;
        }
        .theme-colors span {
          width: 7px;
          height: 7px;
          border-radius: 50%;
          display: inline-block;
        }
        .theme-card-info {
          flex: 1;
        }
        .theme-card-info h4 {
          font-size: 0.82rem;
          font-weight: 600;
          margin-bottom: 0.15rem;
          color: var(--text);
        }
        .theme-card-info p {
          font-size: 0.7rem;
          color: var(--text3);
          line-height: 1.3;
        }
        @media(max-width: 1024px) {
          .constructor-wrapper {
            flex-direction: column;
            height: auto;
          }
          .constructor-sidebar {
            width: 100%;
            min-width: 100%;
            height: auto;
          }
          .constructor-preview-container {
            height: 600px;
          }
        }
      </style>

      <div class="constructor-wrapper">
        <div class="constructor-sidebar">
          <div style="padding: 1.25rem 1.25rem 0.5rem 1.25rem; border-bottom: 1px solid var(--border);">
            <h3 style="font-size:15px; font-weight:700; color:#fff; margin-bottom:0.75rem;">Constructor de Tienda</h3>
            <div class="tabs" style="margin-bottom:0; gap: 0.25rem; border-bottom: none;">
              <div class="tab active" data-tab-group="ss" data-tab-key="appearance" onclick="switchTab('ss','appearance')" style="padding: 0.4rem 0.6rem; font-size: 0.75rem;">Apariencia</div>
              <div class="tab" data-tab-group="ss" data-tab-key="social" onclick="switchTab('ss','social')" style="padding: 0.4rem 0.6rem; font-size: 0.75rem;">Redes Sociales</div>
              <div class="tab" data-tab-group="ss" data-tab-key="legal" onclick="switchTab('ss','legal')" style="padding: 0.4rem 0.6rem; font-size: 0.75rem;">Legales</div>
              <div class="tab" data-tab-group="ss" data-tab-key="seo" onclick="switchTab('ss','seo')" style="padding: 0.4rem 0.6rem; font-size: 0.75rem;">SEO</div>
            </div>
          </div>
          
          <div class="sidebar-scrollable-content">
            <!-- PANE: APARIENCIA -->
            <div class="tab-pane active" data-pane-group="ss" data-pane-key="appearance">
              <div style="margin-bottom:1.25rem;">
                <label class="form-label" style="font-size: 10px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--teal); margin-bottom: 0.75rem;">Detalles del Contenido</label>
                <div class="form-row">
                  <div class="form-group"><label class="form-label">Nombre de la tienda</label><input class="form-control" id="ssName"></div>
                  <div class="form-group"><label class="form-label">Eslogan</label><input class="form-control" id="ssTagline"></div>
                </div>
                <div class="form-row">
                  <div class="form-group"><label class="form-label">URL Logo</label><input class="form-control" id="ssLogo"></div>
                  <div class="form-group"><label class="form-label">URL Banner principal</label><input class="form-control" id="ssBanner"></div>
                </div>
                <div class="form-group">
                  <label class="form-label">Color principal de acento</label>
                  <div style="display:flex; gap:0.5rem; align-items:center;">
                    <input class="form-control" type="color" id="ssColor" style="width:50px; height:38px; padding:2px; flex:0 0 50px; border-radius:6px; cursor:pointer;">
                    <input class="form-control" id="ssColorHex" placeholder="#10b981" style="flex:1;">
                  </div>
                </div>
                <div class="form-group"><label class="form-label">Barra de anuncio</label><input class="form-control" id="ssAnnounce" placeholder="Ej: Envío gratis en pedidos +${sym}50"></div>
              </div>
              
              <div style="border-top: 1px solid var(--border); padding-top: 1rem; margin-top: 1rem; margin-bottom: 1.25rem;">
                <label class="form-label" style="font-size: 10px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--teal); margin-bottom: 0.5rem;">Temas Minimalistas</label>
                <div class="theme-selector-grid">
                  <!-- Card 1: Minimal Light -->
                  <div class="theme-card active" data-theme="minimal_light" onclick="selectTheme('minimal_light')">
                    <div class="theme-card-preview" style="background: #f8fafc; border: 1px solid rgba(0,0,0,0.1);">
                      <span style="font-family: sans-serif; font-weight: 700; color: #0f172a; font-size: 14px;">Aa</span>
                      <div class="theme-colors">
                        <span style="background: #ffffff; border: 1px solid rgba(0,0,0,0.1);"></span>
                        <span style="background: #10b981;"></span>
                        <span style="background: #0f172a;"></span>
                      </div>
                    </div>
                    <div class="theme-card-info">
                      <h4>Minimal Light</h4>
                      <p>Limpio y escandinavo. Fondo claro y fuentes sans-serif.</p>
                    </div>
                  </div>

                  <!-- Card 2: Minimal Dark -->
                  <div class="theme-card" data-theme="minimal_dark" onclick="selectTheme('minimal_dark')">
                    <div class="theme-card-preview" style="background: #0f172a; border: 1px solid rgba(255,255,255,0.1);">
                      <span style="font-family: sans-serif; font-weight: 700; color: #f8fafc; font-size: 14px;">Aa</span>
                      <div class="theme-colors">
                        <span style="background: #0f172a; border: 1px solid rgba(255,255,255,0.1);"></span>
                        <span style="background: #10b981;"></span>
                        <span style="background: #f8fafc;"></span>
                      </div>
                    </div>
                    <div class="theme-card-info">
                      <h4>Minimal Dark</h4>
                      <p>Oscuro elegante. Alto contraste, ideal para productos premium.</p>
                    </div>
                  </div>

                  <!-- Card 3: Nordic Forest -->
                  <div class="theme-card" data-theme="nordic_forest" onclick="selectTheme('nordic_forest')">
                    <div class="theme-card-preview" style="background: #f4f3ef; border: 1px solid rgba(0,0,0,0.1);">
                      <span style="font-family: Georgia, serif; font-weight: 700; color: #1c2e24; font-size: 14px;">Aa</span>
                      <div class="theme-colors">
                        <span style="background: #f4f3ef; border: 1px solid rgba(0,0,0,0.1);"></span>
                        <span style="background: #1b4d3e;"></span>
                        <span style="background: #1c2e24;"></span>
                      </div>
                    </div>
                    <div class="theme-card-info">
                      <h4>Nordic Forest</h4>
                      <p>Orgánico y natural. Fondo crema/hueso, serif y acentos verde bosque.</p>
                    </div>
                  </div>

                  <!-- Card 4: Bold Tech -->
                  <div class="theme-card" data-theme="bold_tech" onclick="selectTheme('bold_tech')">
                    <div class="theme-card-preview" style="background: #ffffff; border: 2px solid #000000; box-shadow: 2px 2px 0px #000000;">
                      <span style="font-family: Impact, sans-serif; font-weight: 900; color: #000000; font-size: 13px; letter-spacing: 0.5px;">Aa</span>
                      <div class="theme-colors">
                        <span style="background: #ffff00; border: 1px solid #000;"></span>
                        <span style="background: #000000;"></span>
                        <span style="background: #ffffff; border: 1px solid #000;"></span>
                      </div>
                    </div>
                    <div class="theme-card-info">
                      <h4>Bold Tech</h4>
                      <p>Brutalismo digital. Bordes rectos sin redondeo y sombras planas gruesas.</p>
                    </div>
                  </div>

                  <!-- Card 5: Vintage Warm -->
                  <div class="theme-card" data-theme="vintage_warm" onclick="selectTheme('vintage_warm')">
                    <div class="theme-card-preview" style="background: #faf6f0; border: 1px solid rgba(0,0,0,0.1);">
                      <span style="font-family: 'Lora', serif; font-style: italic; color: #5c3d2e; font-size: 14px;">Aa</span>
                      <div class="theme-colors">
                        <span style="background: #faf6f0; border: 1px solid rgba(0,0,0,0.1);"></span>
                        <span style="background: #c84b31;"></span>
                        <span style="background: #5c3d2e;"></span>
                      </div>
                    </div>
                    <div class="theme-card-info">
                      <h4>Vintage Warm</h4>
                      <p>Retro acogedor. Fondo arena cálido, tipografías serif y tonos terracota.</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- PANE: SOCIAL -->
            <div class="tab-pane" data-pane-group="ss" data-pane-key="social">
              <div class="form-group"><label class="form-label">Facebook URL</label><input class="form-control" id="ssFB" placeholder="https://facebook.com/..."></div>
              <div class="form-group"><label class="form-label">Instagram URL</label><input class="form-control" id="ssIG" placeholder="https://instagram.com/..."></div>
              <div class="form-group"><label class="form-label">Twitter / X URL</label><input class="form-control" id="ssTW" placeholder="https://twitter.com/..."></div>
            </div>

            <!-- PANE: LEGAL -->
            <div class="tab-pane" data-pane-group="ss" data-pane-key="legal">
              <div class="form-group"><label class="form-label">Términos y Condiciones (HTML)</label><textarea class="form-control" id="ssTerms" rows="6" style="min-height:120px; font-family:monospace; font-size:11px;"></textarea></div>
              <div class="form-group"><label class="form-label">Política de Privacidad (HTML)</label><textarea class="form-control" id="ssPrivacy" rows="6" style="min-height:120px; font-family:monospace; font-size:11px;"></textarea></div>
              <div class="form-group"><label class="form-label">Política de Devoluciones (HTML)</label><textarea class="form-control" id="ssReturns" rows="6" style="min-height:120px; font-family:monospace; font-size:11px;"></textarea></div>
            </div>

            <!-- PANE: SEO -->
            <div class="tab-pane" data-pane-group="ss" data-pane-key="seo">
              <div class="form-group"><label class="form-label">Título SEO (meta title)</label><input class="form-control" id="ssSeoTitle" maxlength="60"></div>
              <div class="form-group"><label class="form-label">Descripción SEO (meta description)</label><textarea class="form-control" id="ssSeoDesc" rows="4" maxlength="160" style="min-height:100px;"></textarea></div>
            </div>
          </div>

          <div class="sidebar-footer">
            <button class="btn btn-primary" onclick="saveStore()" style="width:100%; justify-content:center;">Guardar cambios</button>
          </div>
        </div>

        <div class="constructor-preview-container">
          <div class="preview-header">
            <div class="preview-status">
              <span class="status-dot"></span>
              <span>Vista previa en vivo</span>
            </div>
            <div class="preview-device-selector">
              <button class="device-btn active" data-device="desktop" onclick="setDevice('desktop')">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
                Escritorio
              </button>
              <button class="device-btn" data-device="mobile" onclick="setDevice('mobile')">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>
                Móvil
              </button>
            </div>
          </div>
          <div class="preview-iframe-wrapper">
            <iframe id="previewIframe" class="desktop-size" src="/store"></iframe>
          </div>
        </div>
      </div>

      <script>
      let currentTheme = 'minimal_light';
      let previewTimeout = null;

      function selectTheme(theme) {
        currentTheme = theme;
        document.querySelectorAll('.theme-card').forEach(card => {
          card.classList.toggle('active', card.dataset.theme === theme);
        });
        triggerPreviewUpdate();
      }

      function triggerPreviewUpdate() {
        clearTimeout(previewTimeout);
        previewTimeout = setTimeout(() => {
          updateIframe();
        }, 300);
      }

      function updateIframe() {
        const iframe = document.getElementById('previewIframe');
        if (!iframe) return;
        
        const name = document.getElementById('ssName').value;
        const tagline = document.getElementById('ssTagline').value;
        const logo = document.getElementById('ssLogo').value;
        const banner = document.getElementById('ssBanner').value;
        const color = document.getElementById('ssColor').value;
        const announce = document.getElementById('ssAnnounce').value;
        
        const params = new URLSearchParams();
        params.set('preview_theme', currentTheme);
        params.set('preview_name', name);
        params.set('preview_tagline', tagline);
        params.set('preview_logo', logo);
        params.set('preview_banner', banner);
        params.set('preview_color', color);
        params.set('preview_announce', announce);
        
        iframe.src = '/store?' + params.toString();
      }

      function setDevice(device) {
        const iframe = document.getElementById('previewIframe');
        if (!iframe) return;
        
        document.querySelectorAll('.device-btn').forEach(btn => {
          btn.classList.toggle('active', btn.dataset.device === device);
        });
        
        if (device === 'mobile') {
          iframe.className = 'mobile-size';
        } else {
          iframe.className = 'desktop-size';
        }
      }

      api('GET','/api/erp/settings/store').then(d=>{
        document.getElementById('ssName').value=d.store_name||'';
        document.getElementById('ssTagline').value=d.tagline||'';
        document.getElementById('ssLogo').value=d.logo_url||'';
        document.getElementById('ssBanner').value=d.banner_url||'';
        document.getElementById('ssColor').value=d.primary_color||'#10b981';
        document.getElementById('ssColorHex').value=d.primary_color||'#10b981';
        document.getElementById('ssAnnounce').value=d.announcement||'';
        document.getElementById('ssFB').value=d.facebook_url||'';
        document.getElementById('ssIG').value=d.instagram_url||'';
        document.getElementById('ssTW').value=d.twitter_url||'';
        document.getElementById('ssTerms').value=d.terms_html||'';
        document.getElementById('ssPrivacy').value=d.privacy_html||'';
        document.getElementById('ssReturns').value=d.returns_html||'';
        document.getElementById('ssSeoTitle').value=d.seo_title||'';
        document.getElementById('ssSeoDesc').value=d.seo_description||'';
        
        currentTheme = d.theme || 'minimal_light';
        selectTheme(currentTheme);

        // Keep color inputs in sync
        const cp = document.getElementById('ssColor');
        const ch = document.getElementById('ssColorHex');
        cp.addEventListener('input', () => { ch.value = cp.value; triggerPreviewUpdate(); });
        ch.addEventListener('input', () => { cp.value = ch.value; triggerPreviewUpdate(); });

        // Event listeners for live preview reload
        ['ssName', 'ssTagline', 'ssLogo', 'ssBanner', 'ssAnnounce'].forEach(id => {
          const el = document.getElementById(id);
          if (el) el.addEventListener('input', triggerPreviewUpdate);
        });

        // Initial preview load
        updateIframe();
      });

      async function saveStore(){
        try{
          await api('PUT','/api/erp/settings/store',{
            store_name:document.getElementById('ssName').value,
            tagline:document.getElementById('ssTagline').value,
            logo_url:document.getElementById('ssLogo').value,
            banner_url:document.getElementById('ssBanner').value,
            primary_color:document.getElementById('ssColor').value,
            announcement:document.getElementById('ssAnnounce').value,
            facebook_url:document.getElementById('ssFB').value,
            instagram_url:document.getElementById('ssIG').value,
            twitter_url:document.getElementById('ssTW').value,
            terms_html:document.getElementById('ssTerms').value,
            privacy_html:document.getElementById('ssPrivacy').value,
            returns_html:document.getElementById('ssReturns').value,
            seo_title:document.getElementById('ssSeoTitle').value,
            seo_description:document.getElementById('ssSeoDesc').value,
            theme:currentTheme
          });
          toast('Guardado ✓');
          updateIframe();
        }catch(e){toast(e.message,'err')}
      }
      </script>`;
    return c.html(adminLayout('Personalización de Tienda', content, 'store-settings', c.get('session')?.csrfToken || '', c.get('session')?.role || ''));
  });

  return { api, views, storeViews };
}
